{
  "name": "simurgencias",
  "version": "0.1.0",
  "description": "Simulador de eventos discretos del servicio de urgencias (Valledupar)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "vitest run tests/validation",
    "report": "vite-node tools/validation-report.ts",
    "mock": "vite-node tools/export-mock-events.ts",
    "experiment": "vite-node tools/doctor-experiment.ts",
    "welch": "vite-node tools/welch.ts",
    "accidente": "vite-node tools/mass-casualty.ts",
    "red-vial": "vite-node tools/valledupar-map.ts",
    "satelite": "vite-node tools/valledupar-satelite.ts"
  },
  "author": "Libni Jahzeel Torres Castro",
  "license": "UNLICENSED",
  "devDependencies": {
    "typescript": "~5.6",
    "vite": "~5.4",
    "vite-node": "~2.1",
    "vitest": "~2.1"
  },
  "dependencies": {
    "chart.js": "^4.4.4",
    "phaser": "^3.80.1"
  },
  "private": true,
  "type": "module"
}
